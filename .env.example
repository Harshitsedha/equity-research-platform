# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Anthropic API key for the real Claude LLM adapter (Phase 1B).
# Required by scripts/phase1b_demo.py, the opt-in live test, and the worker when
# LLM_PROVIDER=claude. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which LLM adapter the composition root wires: "stub" (default, deterministic,
# no network) or "claude" (real API; needs ANTHROPIC_API_KEY).
LLM_PROVIDER=stub

# PostgreSQL (ledger / system of record). Default matches docker-compose (host 5434).
DATABASE_URL=postgresql+psycopg://research:research@localhost:5434/research

# Redis broker for the arq worker only (host 6380 per docker-compose).
REDIS_URL=redis://localhost:6380
